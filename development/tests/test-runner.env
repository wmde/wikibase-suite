# You can override any of these in ../local.env
# Set WBS_TEST_MAX_INSTANCES=1 there to cap CPU- and memory-intensive parallel suites.
WBS_TEST_HEADED=false
MOCHA_OPTS_TIMEOUT=120000
WAIT_FOR_TIMEOUT=30000
TEST_LOG_LEVEL=debug

# CHANGES TO ANYTHING BELOW IS EXPERIMENTAL AND NOT CURRENTLY SUPPORTED
# use a fixed multi-platform Selenium Chromium version for stability in our testing environment
TEST_BROWSER_IMAGE_URL=selenium/standalone-chromium:150.0-chromedriver-150.0-grid-4.46.0-20260707
MAX_INSTANCES=1
