{
	"compilerOptions": {
		"target": "es2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"rootDir": ".",
		"outDir": "dist"
	},
	"exclude": ["node_modules", "web/client", "dist", "web/public/assets", "web/vite.config.ts"],
	"include": ["wbs.ts", "commands/**/*.ts", "cli/**/*.ts", "web/**/*.ts", "lib/**/*.ts"]
}
