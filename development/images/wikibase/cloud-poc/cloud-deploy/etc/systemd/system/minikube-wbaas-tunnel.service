[Unit]
Description=Minikube tunnel for the Wikibase Cloud POC
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
Environment=HOME=/home/wbaas
ExecStart=/usr/local/bin/minikube -p minikube-wbaas tunnel
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
