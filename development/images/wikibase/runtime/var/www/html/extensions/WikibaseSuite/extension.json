{
	"name": "WikibaseSuite",
	"version": "1.0.0",
	"author": ["Wikibase Suite Team"],
	"url": "https://www.mediawiki.org/wiki/Wikibase/Suite",
	"namemsg": "wikibasesuite-extensionname",
	"descriptionmsg": "wikibasesuite-desc",
	"type": "other",
	"license-name": "BSD-3-Clause",
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\WikibaseSuite\\": "includes/"
	},
	"callback": "MediaWiki\\Extension\\WikibaseSuite\\Hooks::onRegistration",
	"APIMetaModules": {
		"wikibasesuite": "MediaWiki\\Extension\\WikibaseSuite\\ApiQueryWikibaseSuite"
	},
	"Hooks": {
		"BeforeInitialize": "MediaWiki\\Extension\\WikibaseSuite\\Hooks::onBeforeInitialize",
		"BeforePageDisplay": "MediaWiki\\Extension\\WikibaseSuite\\Hooks::onBeforePageDisplay",
		"SoftwareInfo": "MediaWiki\\Extension\\WikibaseSuite\\Hooks::onSoftwareInfo",
		"SidebarBeforeOutput": "MediaWiki\\Extension\\WikibaseSuite\\Hooks::onSidebarBeforeOutput",
		"TestCanonicalRedirect": "MediaWiki\\Extension\\WikibaseSuite\\Hooks::onTestCanonicalRedirect"
	},
	"SpecialPages": {
		"WikibaseDashboard": "MediaWiki\\Extension\\WikibaseSuite\\SpecialWikibaseDashboard"
	},
	"ResourceModules": {
		"ext.wikibasesuite.vector2022": {
			"styles": ["resources/wbs.css"]
		},
		"ext.wikibasesuite.pinAnonymousMainMenu": {
			"scripts": ["resources/pinAnonymousMainMenu.js"]
		},
		"ext.wikibasesuite.dashboard": {
			"class": "MediaWiki\\ResourceLoader\\CodexModule",
			"packageFiles": [
				"resources/ext.wikibasesuite.dashboard/init.js",
				"resources/ext.wikibasesuite.dashboard/WikibaseDashboardApp.vue"
			],
			"styles": ["resources/ext.wikibasesuite.dashboard/dashboard.css"],
			"codexComponents": ["CdxMessage", "CdxButton"],
			"dependencies": ["codex-styles"]
		},
		"ext.wikibasesuite.dashboard.styles": {
			"styles": ["resources/ext.wikibasesuite.dashboard.css"]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": ".",
		"remoteExtPath": "WikibaseSuite"
	},
	"MessagesDirs": {
		"WikibaseSuite": ["i18n"]
	},
	"manifest_version": 2
}
