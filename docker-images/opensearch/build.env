# Selection, compatibility, and version-impact policy: ./UPDATING.md
# CirrusSearch for MediaWiki 1.46 supports OpenSearch 1.3.x.
OPENSEARCH_VERSION=1.3.20
OPENSEARCH_IMAGE_URL=opensearchproject/opensearch:1.3.20

# ##############################################################################
# Plugins
# ##############################################################################
# https://central.sonatype.com/artifact/org.wikimedia.search/opensearch-extra
OPENSEARCH_PLUGIN_WIKIMEDIA_EXTRA=1.3.20-wmf9

# https://central.sonatype.com/artifact/org.wikimedia.search.highlighter/cirrus-highlighter-opensearch-plugin
OPENSEARCH_PLUGIN_WIKIMEDIA_HIGHLIGHTER=1.3.20-wmf5

IMAGE_TAGS="os${OPENSEARCH_VERSION?}"
