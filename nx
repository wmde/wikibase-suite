#!/usr/bin/env bash

set -e

# Create a local.env if it doesn't already exist
[ -f "local.env" ] || touch local.env
source local.env

# Execute nx directly when already running in the build-tools container.
if [[ -f /.dockerenv ]]; then
  exec pnpm exec nx "$@"
fi

# Otherwise, build or load the exact build-tools image and run nx in it.

# Create the expected Docker network if it doesn't exist
docker network create wbs-dev > /dev/null 2>&1 || true

./build-tools.sh

if [[ "${1:-}" == "release" ]]; then
  exec docker compose --progress quiet run --rm -e NX_PREFER_TS_NODE=true runner -c 'pnpm exec nx "$@"' -- "$@"
fi

exec docker compose --progress quiet run --rm runner -c 'pnpm exec nx "$@"' -- "$@"
